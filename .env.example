# Copy to .env for local runs. On Railway, add these under Variables instead.
# Never commit real keys. Everything except one delivery channel is optional.

# ---------------------------------------------------------------- WhatsApp
# CallMeBot (free, personal use): message the CallMeBot WhatsApp number listed
# on callmebot.com with "I allow callmebot to send me messages"; it replies
# with your API key.
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=+15105550123
CALLMEBOT_API_KEY=
# Twilio instead (paid; free-form messages only within 24h of your last
# message to the Twilio number, otherwise WhatsApp requires a template):
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------------------------------------------------------------- Telegram
# Token from @BotFather. Send /start to the bot to see your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only these chats may use the interactive bot (comma separated)
ALLOWED_CHAT_IDS=

# ---------------------------------------------------------------- Other channels
DISCORD_WEBHOOK_URL=
WEBHOOK_URL=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ---------------------------------------------------------------- What to watch
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,NFLX,AMD,AVGO
# Your holdings: TICKER[:shares[@avg_cost]], comma separated
PORTFOLIO=
# Option positions: UNDERLYING:EXPIRY:STRIKE+C/P:CONTRACTS@PRICE_PAID_PER_SHARE
# (the per-share price Robinhood shows, e.g. 6.90 – not 690). Example:
# OPTIONS=APLD:2027-01-15:25C:20@6.897,INTC:2027-06-17:100C:1@25
OPTIONS=
# Leveraged/inverse ETFs are judged on the company behind them (earnings
# blackout, sector guard, fundamentals, decay math). Built in: SNXX=SNDK,
# APLX=APLD, SOFX=SOFI, RCAX=RCAT, ONDG=ONDS, NVDL, TSLL, TQQQ, SQQQ, UPRO,
# SPXL, SPXU. Add more as ETF:UNDERLYING:FACTOR, e.g. SOXL:SOXX:3,XYZU:XYZ:2
LEVERAGED_ETFS=
SCAN_INTERVAL_MINUTES=30

# ---------------------------------------------------------------- Morning brief
BRIEF_ENABLED=true
BRIEF_TIME=06:00
BRIEF_TZ=America/Los_Angeles
BRIEF_DAYS=mon,tue,wed,thu,fri,sat,sun
# true: two messages – market news, then your stocks. false: one message.
BRIEF_SPLIT=true
# How many of your largest holdings get the full block (fundamentals,
# analysts, decay math); the rest get one line each
BRIEF_DEEP_STOCKS=6
# Optional AI section – Claude with web search: what moved markets, Washington
# and the Fed (incl. rate odds), what the pros say, scenarios, lesson of the
# day, and per-stock news with bull/bear cases for your largest holdings
ANTHROPIC_API_KEY=
BRIEF_MODEL=claude-sonnet-5-5
BRIEF_LANGUAGE=English
BRIEF_MAX_SEARCHES=8

# ---------------------------------------------------------------- Alert rules
# LOW | MODERATE | HIGH | VERY HIGH  (in a CAUTION market, CALLs need HIGH anyway)
MIN_CONFIDENCE=MODERATE
ALERT_COOLDOWN_HOURS=24
# Also alert when a trend is valid but the entry trigger hasn't fired yet
ALERT_SETUPS=false
# true (default): one scan ~10 min after the close on completed daily bars –
# the same thing the backtest tests. false: also scan intraday on the
# unfinished candle every SCAN_INTERVAL_MINUTES (earlier, but noisier).
CONFIRM_ON_CLOSE=true
EARNINGS_BLACKOUT_DAYS=14
# block (default): no trade if the earnings date can't be verified; warn: allow, lower confidence
EARNINGS_UNKNOWN=block
REGIME_FILTER=true
SECTOR_GUARD=true
# Force a sector ETF for a ticker, e.g. TSLA:XLY,PLTR:XLK
SECTOR_OVERRIDES=
EVENTS_FILE=events.yaml

# ---------------------------------------------------------------- Trade plan
TARGET_R=2
MAX_HOLD_DAYS=20
# Set these to get a share count in each alert
ACCOUNT_SIZE=
RISK_PER_TRADE_PCT=1

# Where alert history and caches live (mount a Railway volume here)
DATA_DIR=data
